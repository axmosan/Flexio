<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  ExtensionBundleId="com.flexio"
  ExtensionBundleName="Flexio"
  ExtensionBundleVersion="1.1.0"
  Version="12.0">

  <ExtensionList>
    <Extension Id="com.flexio.panel1" Version="1.1.0" />
    <Extension Id="com.flexio.panel2" Version="1.1.0" />
    <Extension Id="com.flexio.panel3" Version="1.1.0" />
    <Extension Id="com.flexio.panel4" Version="1.1.0" />
    <Extension Id="com.flexio.settings" Version="1.1.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[25.0,99.9]" />
      <Host Name="PPRO" Version="[25.0,99.9]" />
      <Host Name="ILST" Version="[29.0,99.9]" />
      <Host Name="PHXS" Version="[26.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>

    <!-- Panel 1 -->
    <Extension Id="com.flexio.panel1">
      <DispatchInfo>
        <Resources>
          <MainPath>./dist/src/panel/index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Flexio 1</Menu>
          <Geometry>
            <Size>
              <Height>300</Height>
              <Width>400</Width>
            </Size>
            <MinSize>
              <Height>48</Height>
              <Width>48</Width>
            </MinSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>

